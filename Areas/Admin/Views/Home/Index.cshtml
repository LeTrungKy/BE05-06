@model BE05_06.Models.ViewModel.HomeStatsVM

@{
    ViewBag.Title = "Trang chủ Admin";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var chartData = new List<object[]>();
    chartData.Add(new object[] { "Danh mục", "Số sản phẩm" });
    foreach (var s in Model.CategoryStats)
    {
        chartData.Add(new object[] { s.Name, s.Count });
    }
}

<div class="panel panel-success">
    <div class="panel-heading">
        <h3 class="panel-title">BIỂU ĐỒ THỐNG KÊ</h3>
    </div>
    <div class="panel-body">

        <div class="row" style="margin-bottom:20px;">
            <div class="col-md-3">
                <div class="well text-center">
                    <h2>@Model.ProductCount</h2>
                    <p>Sản phẩm</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="well text-center">
                    <h2>@Model.CategoryCount</h2>
                    <p>Danh mục</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="well text-center">
                    <h2>@Model.CustomerCount</h2>
                    <p>Khách hàng</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="well text-center">
                    <h2>@Model.OrderCount</h2>
                    <p>Đơn hàng</p>
                </div>
            </div>
        </div>

        <p class="text-right">
            <strong>Tổng doanh thu:</strong> @string.Format("{0:N0} đ", Model.Revenue)
        </p>

        @if (Model.ProductCount == 0)
        {
            <div class="alert alert-info">Chưa có sản phẩm nào để thống kê.</div>
        }
        else
        {
            <div id="piechart_3d" style="width:100%; height:450px;"></div>
        }
    </div>
</div>

<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script type="text/javascript">
    google.charts.load("current", { packages: ["corechart"] });
    google.charts.setOnLoadCallback(drawChart);

    function drawChart() {
        var element = document.getElementById("piechart_3d");
        if (!element) { return; }

        var data = google.visualization.arrayToDataTable(@Html.Raw(Json.Encode(chartData)));

        var options = {
            title: "TỶ LỆ HÀNG HÓA",
            is3D: true,
            pieSliceText: "percentage"
        };

        var chart = new google.visualization.PieChart(element);
        chart.draw(data, options);

        window.addEventListener("resize", function () { chart.draw(data, options); });
    }
</script>
